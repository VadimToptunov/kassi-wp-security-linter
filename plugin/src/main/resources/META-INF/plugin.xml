<idea-plugin>
    <id>io.github.vadimtoptunov.kassi-wp-security</id>
    <name>Kassi Security Inspections for WordPress</name>
    <vendor email="vtoptunov88@gmail.com" url="https://github.com/VadimToptunov">Vadim Toptunov</vendor>

    <description><![CDATA[
    <p>Static security inspections for WordPress plugin and theme code in PhpStorm: missing capability
    and nonce checks in admin/AJAX handlers, REST routes without a permission callback, unprepared SQL,
    unescaped output, unsafe file paths and unsafe redirects.</p>
    <p>Deterministic and fully offline: no network calls, no telemetry. Every rule maps to a CWE and is
    backed by a real, fixed CVE from the WordPress plugin ecosystem.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>
    <depends>com.jetbrains.php</depends>

    <extensions defaultExtensionNs="com.intellij">
        <localInspection language="PHP" shortName="WP004UnprotectedRestRoute"
                         displayName="WP-004 REST route without a real permission_callback"
                         groupName="Kassi WordPress Security" enabledByDefault="true" level="WARNING"
                         implementationClass="io.github.vadimtoptunov.kassi.wp.plugin.inspections.WP004UnprotectedRestRouteInspection"/>
        <localInspection language="PHP" shortName="WP005UnpreparedSql"
                         displayName="WP-005 SQL built from request data without $wpdb-&gt;prepare()"
                         groupName="Kassi WordPress Security" enabledByDefault="true" level="ERROR"
                         implementationClass="io.github.vadimtoptunov.kassi.wp.plugin.inspections.WP005UnpreparedSqlInspection"/>
        <localInspection language="PHP" shortName="WP006UnescapedOutput"
                         displayName="WP-006 Request data output without escaping"
                         groupName="Kassi WordPress Security" enabledByDefault="true" level="WARNING"
                         implementationClass="io.github.vadimtoptunov.kassi.wp.plugin.inspections.WP006UnescapedOutputInspection"/>
        <localInspection language="PHP" shortName="WP008UnsafeRedirect"
                         displayName="WP-008 wp_redirect() to a URL from request data"
                         groupName="Kassi WordPress Security" enabledByDefault="true" level="WARNING"
                         implementationClass="io.github.vadimtoptunov.kassi.wp.plugin.inspections.WP008UnsafeRedirectInspection"/>
    </extensions>
</idea-plugin>
